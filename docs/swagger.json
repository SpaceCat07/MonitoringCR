    "definitions": {
        "controllers.createCRRequest": {
            "type": "object",
            "required": [
                "category",
                "description",
                "end_date",
                "file_attachment",
                "release_date",
                "title"
            ],
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "FLOW",
                        "REPORT",
                        "INTERFACE",
                        "CONVERTION",
                        "ENHANCEMENT",
                        "FORM",
                        "CONFIGURATION",
                        "AUTORIZATION"
                    ]
                },
                "description": {
                    "type": "string",
                    "minLength": 3
                },
                "end_date": {
                    "type": "string"
                },
                "file_attachment": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "release_date": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ISSUED",
                        "RELEASE",
                        "IN PROGRESS",
                        "COMPLETE",
                        "CANCEL"
                    ]
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                }
            }
        },
        "controllers.loginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "controllers.registerRequest": {
            "type": "object",
            "required": [
                "email",
                "fullname",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "fullname": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                }
            }
        },
        "controllers.updateCRRequest": {
            "type": "object",
            "required": [
                "category",
                "description",
                "end_date",
                "file_attachment",
                "release_date",
                "status",
                "title"
            ],
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "FLOW",
                        "REPORT",
                        "INTERFACE",
                        "CONVERTION",
                        "ENHANCEMENT",
                        "FORM",
                        "CONFIGURATION",
                        "AUTORIZATION"
                    ]
                },
                "description": {
                    "type": "string",
                    "minLength": 3
                },
                "end_date": {
                    "type": "string"
                },
                "file_attachment": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string"
                    }
                },
                "release_date": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ISSUED",
                        "RELEASE",
                        "IN PROGRESS",
                        "COMPLETE",
                        "CANCEL"
                    ]
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
